# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high  (leave empty for models without reasoning support)
OPENAI_REASONING_EFFORT=low
MAX_CONCURRENT_OPENAI=8
# USD per 1M tokens - only used to report each run's cost. Check current prices on openai.com.
OPENAI_PRICE_INPUT_PER_M=0.10
OPENAI_PRICE_CACHED_INPUT_PER_M=0.10
OPENAI_PRICE_OUTPUT_PER_M=0.50

# Press-release writer ("Create press release" button in the UI)
PRESS_RELEASE_MODEL=
PRESS_RELEASE_REASONING_EFFORT=medium
PRESS_RELEASE_GUIDELINES_FILE=press_release_guidelines.md
PRESS_RELEASE_BYLINE=EEHerald News Desk

# Firecrawl (fallback only - used for JavaScript-only / blocked pages)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_ENABLED=true
# basic = always 1 credit per page. "auto" can silently cost 5 credits per page.
FIRECRAWL_PROXY=basic
# Credits per run = (remaining - reserve) / (runs left in billing period), capped below.
FIRECRAWL_MAX_CREDITS_PER_RUN=15
FIRECRAWL_CREDIT_RESERVE=50
FIRECRAWL_RUNS_PER_DAY=4
# A newsroom that needs Firecrawl is re-scraped at most once per this many hours.
FIRECRAWL_LISTING_COOLDOWN_HOURS=8
FIRECRAWL_MAX_AGE_MINUTES=60
MAX_CONCURRENT_REQUESTS=2

# Direct fetching (free)
HTTP_MAX_CONCURRENT=16
HTTP_MAX_PER_HOST=2
HTTP_TIMEOUT_SECONDS=25

# Scraper Config
LOOKBACK_DAYS=7
MAX_ARTICLES_PER_SITE=20
DIRECT_RECHECK_DAYS=7

# Web UI: automatic daily runs while the UI is open (empty = off)
AUTO_RUN_TIMES=

# Paths
OUTPUT_DIR=output_docs
STATE_FILE=scraper_state.json
